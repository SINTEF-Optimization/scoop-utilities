<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net8.0</TargetFrameworks>
    <Platforms>AnyCPU;x64</Platforms>
    <LangVersion>12.0</LangVersion>
    <AssemblyOriginatorKeyFile>SignKey.snk</AssemblyOriginatorKeyFile>
    <RootNamespace>Sintef.Scoop.Utilities</RootNamespace>
    <Product>Scoop Utilities</Product>
    <Description>Scoop Utility Tools Library</Description>
    <Company>SINTEF</Company>
    <Authors>SINTEF Mathematics and Cybernetics</Authors>
    <Copyright>Copyright © SINTEF 2025</Copyright>
    <Version>2.0.0</Version>

    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <PackageId>Sintef.Scoop.Utilities</PackageId>
    <AssemblyName>Sintef.Scoop.Utilities</AssemblyName>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Debug|AnyCPU'">
    <DefineConstants>DEBUG;TRACE</DefineConstants>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Debug|x64'">
    <DefineConstants>DEBUG;TRACE</DefineConstants>
  </PropertyGroup>

  <PropertyGroup>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <WarningsAsErrors/>
  </PropertyGroup>

  <PropertyGroup>
    <!--
    Disable NETSDK1023, which is generated by the inclusion of NETStandard.Library below.
    We include NETStandard explicitly in order to prevent C5 pulling in an older version, which causes
    further cryptography packages with long names to be pulled in. These long names are a problem
    for Git on Windows (Gates).
    Disable NU1803 which warns about nuget restore from non HTTPS sources will be removed in a
    future version. People who still has the old SINTEF nuget server as source need these warnings
    removed as they prevent building with TreatWarningsAsErrors enabled.
    -->
    <NoWarn>1701;1702;NETSDK1023;NU1803</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="C5" Version="2.5.3"/>
    <PackageReference Include="Microsoft.CSharp" Version="4.6.0"/>
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3"/>
    <PackageReference Include="NETStandard.Library" Version="2.0.3"/>
    <PackageReference Include="System.Memory" Version="4.5.5"/>
    
  </ItemGroup>

  <ItemGroup Condition=" '$(TargetFramework)' == 'net472' or '$(TargetFramework)' == 'net48' ">
    <Reference Include="System.IO.Compression"/>
  </ItemGroup>
  
  <ItemGroup>
    <InternalsVisibleTo Include="$(ProjectName).Tests"/>
  </ItemGroup>

</Project>
