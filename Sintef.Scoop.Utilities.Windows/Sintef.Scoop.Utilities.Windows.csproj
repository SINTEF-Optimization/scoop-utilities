<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Library</OutputType>
    <TargetFrameworks>net8.0-windows</TargetFrameworks>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <LangVersion>12.0</LangVersion>
    <UseWindowsForms>true</UseWindowsForms>
    <UseWPF>true</UseWPF>
    <RootNamespace>Sintef.Scoop.Utilities</RootNamespace>
    <Copyright>Copyright © SINTEF 2025</Copyright>
    <Product>ScoopUtilities</Product>
    <Company>SINTEF</Company>
    <Authors>SINTEF Mathematics and Cybernetics</Authors>
    <Version>2.0.0</Version>

    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <PackageId>Sintef.Scoop.Utilities.Framework</PackageId>
    <AssemblyName>Sintef.Scoop.Utilities.Framework</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="HIC.System.Windows.Forms.DataVisualization" Version="1.0.1"/>
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'net472' or '$(TargetFramework)' == 'net48'">
    <Reference Include="System.Windows.Forms.DataVisualization"/>
    <Reference Include="System.ServiceModel"/>
    <PackageReference Include="System.Resources.Extensions" Version="6.0.0"/>
  </ItemGroup>

  <PropertyGroup>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <WarningsAsErrors/>
  </PropertyGroup>

  <PropertyGroup>
    <GenerateResourceUsePreserializedResources>true</GenerateResourceUsePreserializedResources>
  </PropertyGroup>
  
  <ItemGroup>
    <PackageReference Include="MSTest.TestFramework" Version="3.9.2"/>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Sintef.Scoop.Utilities\Sintef.Scoop.Utilities.csproj"/>
  </ItemGroup>

</Project>
