<Window x:Class="Sintef.Scoop.Utilities.GUI.StringInputDialog"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:Sintef.Scoop.Utilities.GUI"
             mc:Ignorable="d" 
             d:DesignHeight="285" d:DesignWidth="699" SizeToContent="WidthAndHeight">
		<Grid Margin="0,0,2,-3">
				<Grid.ColumnDefinitions>
						<ColumnDefinition />
				</Grid.ColumnDefinitions>

				<Grid.RowDefinitions>
						<!--Lable-->
						<RowDefinition Height="Auto" />
						<!--Input-->
						<RowDefinition Height="140*" />
						<RowDefinition Height="70*" MaxHeight="100"/>
						<!--Buttons-->
						<RowDefinition Height="60" MinHeight="60" MaxHeight="60" />
				</Grid.RowDefinitions>

				<Label Name="_question"  Grid.Column="0" Grid.Row="0" Margin="10" />
				<TextBox Name="_userInput" Grid.Column="0" Grid.Row="1" Grid.RowSpan="2" Margin="40,10" />
				<!-- Accept or Cancel -->
				<StackPanel Grid.Column="0" Grid.Row="3" VerticalAlignment="Center" Orientation="Horizontal" Height="50" Margin="0" HorizontalAlignment="Right">
						<Button Name="_cancelButton" IsCancel="True" Margin="10,10,0,10">Cancel</Button>
						<Button Name="_okButton" Click="okButton_Click" IsDefault="True" Margin="10">OK</Button>
				</StackPanel>
		</Grid>
</Window>
